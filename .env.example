# Kopieren nach .env und ausfüllen. .env wird nicht eingecheckt.
# Nach jeder Änderung die App neu starten.

# ============================================================
# Paperless-ngx (Pflicht)
# ============================================================
# Im Heimnetz ist die lokale Adresse schneller, z. B. http://192.168.1.10:8000
PAPERLESS_URL=https://paperless.schroederhub.de
# Paperless → Profil (oben rechts) → API-Token
PAPERLESS_TOKEN=

# Nur nötig, wenn Cloudflare Access (Login-Schutz) vor Paperless hängt:
# Cloudflare Zero Trust → Access → Service Auth → Service Token
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ============================================================
# KI – genau EINEN Block aktiv lassen, die anderen auskommentieren
# ============================================================

# --- A) Lokal mit Ollama (kostenlos, nichts verlässt den Rechner) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5vl:7b

# --- B) OpenRouter (viele Modelle, ein Key, Bezahlung pro Nutzung) ---
# Key: https://openrouter.ai/settings/keys  (beginnt mit sk-or-)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=google/gemini-2.5-flash-lite

# --- C) OpenAI direkt ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini

# --- D) Ohne KI: Trennstellen setzt du selbst ---
# LLM_BASE_URL=

# ============================================================
# Fallback: Consume-Ordner auf der NAS (optional)
# ============================================================
# CONSUME_DIR=\\NAS\paperless\consume
CONSUME_DIR=
